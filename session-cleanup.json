{
  "enabled": true,
  "retentionDays": 30,
  "sessionRoots": ["{agentDir}/sessions"],
  "rules": [
    {
      "name": "workspace-history",
      "type": "paths",
      "root": "{agentDir}/state/workspace-history/workspaces",
      "patterns": ["*/sessions/{sessionId}"],
      "guards": [{ "file": "active-session.json", "pidField": "processId" }]
    },
    {
      "name": "context-mode-session-rows",
      "type": "sqlite",
      "root": "{home}/.pi/context-mode/sessions",
      "patterns": ["*.db"],
      "key": "sessionPathHash16",
      "tables": [
        { "table": "session_events", "column": "session_id" },
        { "table": "session_resume", "column": "session_id" },
        { "table": "tool_calls", "column": "session_id" },
        { "table": "session_meta", "column": "session_id" }
      ]
    },
    {
      "name": "context-mode-attributed-content",
      "type": "sqlite",
      "root": "{home}/.pi/context-mode/content",
      "patterns": ["*.db"],
      "key": "sessionPathHash16",
      "tables": [
        { "table": "chunks", "column": "session_id" },
        { "table": "chunks_trigram", "column": "session_id" }
      ]
    }
  ]
}

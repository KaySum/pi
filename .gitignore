# Pi credentials and generated model state
/auth.json
/auth.json.*
/models-store.json
/models-store.json.*

# Conversation history (may contain private code and tool output)
/sessions/

# Local environment secrets
.env
.env.*
!.env.example
!.env.sample

# Dependencies and logs
node_modules/
*.log

# macOS and editor temporary files
.DS_Store
*.swp
*.swo
*~

# Keep settings.json, themes/, extensions/, skills/, prompts/, and
# instruction files tracked. Never put API keys in tracked configuration.

/state

# Local background task artifacts (may contain conversation snapshots)
/.pi/tasks/
/.pi/delegate/
/.pi/fusion/
